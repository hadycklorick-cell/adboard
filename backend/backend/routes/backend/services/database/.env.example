# ─── ADBOARD — Configuração de ambiente ───────────────────────
# Copie este arquivo para .env e preencha os valores

# ── Banco de dados PostgreSQL ──────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/adboard

# ── Segurança da API ───────────────────────────────────────────
# Gere uma chave aleatória: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=troque_por_uma_chave_segura_aqui

# ── Yampi ──────────────────────────────────────────────────────
# Token de validação dos webhooks (configure o mesmo no painel Yampi)
YAMPI_WEBHOOK_TOKEN=token_webhook_yampi_opcional

# ── Servidor ───────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── COMO PEGAR O TOKEN YAMPI ───────────────────────────────────
# 1. Acesse seu painel Yampi: https://app.yampi.com.br
# 2. Vá em: Configurações → Dados da conta → API
# 3. Copie o "User Token" (começa com "user:...")
# 4. O "Alias" é o slug da sua loja (ex: se sua URL é minhaloja.yampi.com.br, o alias é "minhaloja")
#
# COMO CRIAR O BANCO DE DADOS ──────────────────────────────────
# Opção 1 — Local (PostgreSQL instalado):
#   createdb adboard
#   psql adboard < database/schema.sql
#
# Opção 2 — Supabase (gratuito, recomendado):
#   1. Crie conta em https://supabase.com
#   2. Novo projeto → copie a Connection String
#   3. Cole em DATABASE_URL acima
#   4. No SQL Editor do Supabase, cole e execute o conteúdo de database/schema.sql
#
# Opção 3 — Railway (deploy fácil):
#   1. https://railway.app → New Project → PostgreSQL
#   2. Copie a DATABASE_URL gerada
